omod DYNAMICS-FUNCTIONS is
  including LF-REPR .
  including ABS-DYNAMICS-WITHOUT-TICK .
  including EVENT-QUEUE .
  including PHYSICAL-ACTIONS .

  var REACTORID : ReactorId .
  vars N N2 : Nat .
  vars T T1 T2 : Time .
  vars TI TI1 : TimeInf .
  vars GRAPH NETWORK PHYSICAL-ACTIONS REST : Configuration .
  vars OS TRIGGERIDS : OidSet .
  vars RB RB2 : ReactionBody .
  var TSTATUS : TriggerStatus .
  vars PRE INVOKED RIDS : ReactionIdSet .
  vars REACTIONS1 REACTIONS2 : ReactionList .
  vars O PA : Oid .
  vars EVENTS : Events .
  vars EQ1 EQ2 QUEUE : EQueue .
  var EVENT : Event .
  var TAG : Tag .
  var RID : ReactionId .
  var VAR : VarId .
  var VAL : Value .
  var RS : ReactorState .


  op executeReactions : Configuration Time -> Configuration .
  eq executeReactions(< (REACTORID . N ) : APGNode | status : executing(T) > GRAPH, T2)
   = < (REACTORID . N ) : APGNode | status : executing(T plus T2) > 
    executeReactions(GRAPH, T2) .
  eq executeReactions(NETWORK, T) = NETWORK [owise] .

  op maxRemainingExecutionTime : Configuration Configuration -> TimeInf .     --- GRAPH NETWORK
  op noIdling : Configuration Nat -> Bool .

  eq maxRemainingExecutionTime(< (REACTORID . N) : APGNode | status : executing(T) > GRAPH,
    NETWORK
    < REACTORID : Reactor | 
        reactions : REACTIONS1 (reaction N when TRIGGERIDS --> OS do {RB} deadline TI {RB2} exTime T1 TI1 ) REACTIONS2 >
  ) =
    minimum(TI1 monus T, maxRemainingExecutionTime(GRAPH, NETWORK < REACTORID : Reactor | > )) .

  eq maxRemainingExecutionTime(GRAPH, NETWORK) = INF [owise] .

  ceq noIdling(< (REACTORID . N) : APGNode | triggers : TSTATUS, status : present, pre : PRE > GRAPH, s N2) = false 
  if presetOK(PRE, GRAPH)
    /\ allTriggersDecided(TSTATUS)
  .
  eq noIdling(GRAPH, N2) = true [owise] .

   
  op decreaseTags : EQueue Time -> EQueue .
  eq decreaseTags(empty, T) = empty .
  eq decreaseTags((EVENTS at tag(T2, N)) :: QUEUE, T) =
     (EVENTS at tag(T2 monus T, N)) :: decreaseTags(QUEUE, T) .

  *** decrease timers in out physical action objects:
  op decreaseTimers : Configuration Time -> Configuration .
  eq decreaseTimers(none, T) = none .
  eq decreaseTimers(< PA : PhysAct | leftOfPeriod : TI >   PHYSICAL-ACTIONS, T)
  = < PA : PhysAct | leftOfPeriod : TI monus T >   decreaseTimers(PHYSICAL-ACTIONS, T) .

  op smallestTimer : Configuration -> TimeInf .
  eq smallestTimer(none) = INF .
  eq smallestTimer(< PA : PhysAct | leftOfPeriod : TI >   PHYSICAL-ACTIONS)
   = minimum(TI, smallestTimer(PHYSICAL-ACTIONS)) .
   
  *** Here starts helper functions for analysis
  op _._in_ : ReactorId VarId Configuration -> Value .
  op _inQueue_ : Event Configuration -> Bool .
  op _invoked_ : ReactionId Configuration -> Bool .
   
  eq REACTORID . VAR in REST
      < REACTORID : Reactor | state : (VAR |-> VAL) ; RS > = VAL .
      
  eq EVENT inQueue REST
      < O : EventQueue | queue : (EQ1 :: ((EVENT EVENTS) at TAG) :: EQ2) > = true .
  eq EVENT inQueue REST = false [owise] .    
      
  eq RID invoked REST
      < O : Invoked | reactions : (RID ; RIDS) > = true .
  eq RID invoked REST = false [owise] .

endom

*** Case 1: standard tick rule for simulation:
omod SIMULATION-DYNAMICS-COMMON is
  including DYNAMICS-FUNCTIONS .

  vars REACTORS-AND-CONNECTIONS CONF1 PHYSICAL-ACTIONS : Configuration .
  vars T1 T T2 PT LT : Time .
  vars TI TI1 TI2 : TimeInf .
  vars E Q RXNS : Oid .
  vars N N2 NP2 NP : Nat .
  var EVENTS : Events .
  var QUEUE : EQueue .
  var NETWORK : Configuration .
  var REACTORID : ReactorId .
  var GRAPH : Configuration .
  vars REACTIONS1 REACTIONS2 : ReactionList .
  vars OS TRIGGERIDS : OidSet .
  vars RB RB1 RB2 : ReactionBody .
  vars CONST CONST' : BoolValue .
  var TSTATUS : TriggerStatus .
  vars PRE INVOKED : ReactionIdSet .


  crl [tick] :
    {< E : Environment | physicalActions : CONF1 >
     REACTORS-AND-CONNECTIONS
     < Q : EventQueue | queue : (EVENTS at tag(T1, N)) :: QUEUE >
     < RXNS : Invoked | >
     [physicalTime: PT]
     }
   =>
    {< E : Environment | physicalActions : decreaseTimers(CONF1, T) >
     REACTORS-AND-CONNECTIONS
     < Q : EventQueue | >
     < RXNS : Invoked | reactions : none >
     [physicalTime: PT plus T]
     }
    in time T
   if T := minimum(T1 monus PT, smallestTimer(CONF1))   --- should be nondet time increase, bounded by this value. But for now, we do the easy thing and assume that for each physical action, we have this timer.
   /\ T gt zero .

  crl [tickWhileExecuting] :
  {
    executeStep(
      GRAPH,
      LT,
      < E : Environment | physicalActions : CONF1 >
      NETWORK
      [physicalTime: PT]
      [numberProcessors: NP2] ,
      CONST
    )
  }
  =>
  {
    executeStep(
      executeReactions(GRAPH, T),
      LT,
      < E : Environment | physicalActions : decreaseTimers(CONF1, T) >
      NETWORK
      [physicalTime: PT plus T]
      [numberProcessors: NP2] ,
      CONST
    )
  } in time T
  if T := 1 /\ T le maxRemainingExecutionTime(GRAPH, NETWORK) /\ noIdling(GRAPH, NP2)
    /\ T le smallestTimer(CONF1) .

  crl [extraTickRuleForPhysActs] :
    {< E : Environment | physicalActions : CONF1 >
     REACTORS-AND-CONNECTIONS
     < Q : EventQueue | queue : empty >
     < RXNS : Invoked | >
     [physicalTime: PT]
     }
   =>
    {< E : Environment | physicalActions : decreaseTimers(CONF1, T) >
     REACTORS-AND-CONNECTIONS
     < Q : EventQueue | >
     < RXNS : Invoked | reactions : none >
    [physicalTime: PT plus T]
    }
    in time T
   if T := smallestTimer(CONF1)
   /\ T gt zero
   /\ CONF1 =/= none .      --- implied by typing of T

endom

*** Case 2: for unbounded and unclocked analyses:
omod UNBOUNDED-ANALYSIS-DYNAMICS-COMMON is
  including DYNAMICS-FUNCTIONS .

  vars REACTORS-AND-CONNECTIONS CONF1 PHYSICAL-ACTIONS : Configuration .
  vars T T1 PT : Time .
  vars E Q RXNS : Oid .
  var N : Nat .
  var EVENTS : Events .
  var QUEUE : EQueue .


  crl [tick] :
     {< E : Environment | physicalActions : CONF1 >
      REACTORS-AND-CONNECTIONS
      < Q : EventQueue | queue : (EVENTS at tag(T1, N)) :: QUEUE >
      < RXNS : Invoked | >
      [physicalTime: PT]
      }
   =>
     {< E : Environment | physicalActions : decreaseTimers(CONF1, T) >
      REACTORS-AND-CONNECTIONS
      < Q : EventQueue | >
      < RXNS : Invoked | reactions : none >
      [physicalTime: PT plus T]
      }
   if T := minimum(T1 monus PT, smallestTimer(CONF1))
   /\ T gt zero .


  crl [extraTickRuleForPhysActs] :
     {< E : Environment | physicalActions : CONF1 >
      REACTORS-AND-CONNECTIONS
      < Q : EventQueue | queue : empty >
      < RXNS : Invoked | >
      [physicalTime: PT]
      }
   =>
     {< E : Environment | physicalActions : decreaseTimers(CONF1, T) >
      REACTORS-AND-CONNECTIONS
      < Q : EventQueue | >
      < RXNS : Invoked | reactions : none >
      [physicalTime: PT plus T]
      }
   if T := smallestTimer(CONF1)
   /\ T gt zero
   /\ CONF1 =/= none .      --- implied by typing of T

endom

omod TIME-BOUNDED-DYNAMICS-COMMON is

  including DYNAMICS-FUNCTIONS .

  vars REACTORS-AND-CONNECTIONS CONF1 PHYSICAL-ACTIONS : Configuration .
  vars T1 T T2 T3 T4 PT LT : Time .
  vars TI TI1 TI2 : TimeInf .
  vars E Q RXNS : Oid .
  vars N2 N NP2 NP : Nat .
  var EVENTS : Events .
  var QUEUE : EQueue .
  var NETWORK : Configuration .
  var REACTORID : ReactorId .
  var GRAPH : Configuration .
  vars REACTIONS1 REACTIONS2 : ReactionList .
  vars RB RB1 RB2 : ReactionBody .
  vars CONST CONST' : BoolValue .
  vars OS TRIGGERIDS : OidSet .
  var TSTATUS : TriggerStatus .
  vars PRE INVOKED : ReactionIdSet .

  op timeBound : -> Time .   *** initialized by user

  crl [tick] :
    {< E : Environment | physicalActions : CONF1 >
     REACTORS-AND-CONNECTIONS
     < Q : EventQueue | queue : (EVENTS at tag(T1, N)) :: QUEUE >
     < RXNS : Invoked | >
     [physicalTime: PT]
     } in time T3
   =>
    {< E : Environment | physicalActions : decreaseTimers(CONF1, T) >
     REACTORS-AND-CONNECTIONS
     < Q : EventQueue | >
     < RXNS : Invoked | reactions : none >
     [physicalTime: PT plus T]
     }
    in time (T3 plus T)
   if T := minimum(T1 monus PT, smallestTimer(CONF1))   --- should be nondet time increase, bounded by this value. But for now, we do the easy thing and assume that for each physical action, we have this timer.
   /\ T gt zero 
   /\ T3 plus T le timeBound .


  crl [tickWhileExecuting] :
  {
    executeStep(
      GRAPH,
      LT,
      < E : Environment | physicalActions : CONF1 >
      NETWORK
      [physicalTime: PT]
      [numberProcessors: NP2] ,
      CONST
    )
  } in time T3
  =>
  {
    executeStep(
      executeReactions(GRAPH, T),
      LT,
      < E : Environment | physicalActions : decreaseTimers(CONF1, T) >
      NETWORK
      [physicalTime: PT plus T]
      [numberProcessors: NP2] ,
      CONST
    )
  } in time (T3 plus T)
  if T := 1 /\ T le maxRemainingExecutionTime(GRAPH, NETWORK) /\ noIdling(GRAPH, NP2)
    /\ T le smallestTimer(CONF1) 
    /\ T3 plus T le timeBound .


  crl [extraTickRuleForPhysActs] :
    {< E : Environment | physicalActions : CONF1 >
     REACTORS-AND-CONNECTIONS
     < Q : EventQueue | queue : empty >
     < RXNS : Invoked | >
     [physicalTime: PT]
     } in time T3
   =>
    {< E : Environment | physicalActions : decreaseTimers(CONF1, T) >
     REACTORS-AND-CONNECTIONS
     < Q : EventQueue | >
     < RXNS : Invoked | reactions : none >
    [physicalTime: PT plus T]
    }
    in time (T3 plus T)
   if T := smallestTimer(CONF1)
   /\ T gt zero
   /\ CONF1 =/= none 
   /\ T3 plus T le timeBound .      --- implied by typing of T

endom

*** Case 4: unbounded and time-bounded analysis.
*** The user must do TWO things:
***    a. for unbounded analysis start with state {...} timeBound INF
***    b. for time-bounded analysis set the value after 'timeBound' to the desired value.

omod UNBOUNDED-AND-BOUNDED-ANALYSIS-DYNAMICS is
  including DYNAMICS-FUNCTIONS .

  vars REACTORS-AND-CONNECTIONS CONF1 PHYSICAL-ACTIONS : Configuration .
  vars T1 T T2 PT LT : Time .
  vars TI TI1 TI2 : TimeInf .
  vars E Q RXNS : Oid .
  vars N N2 NP2 NP : Nat .
  var EVENTS : Events .
  var QUEUE : EQueue .
  var NETWORK : Configuration .
  var REACTORID : ReactorId .
  var GRAPH : Configuration .
  vars REACTIONS1 REACTIONS2 : ReactionList .
  vars OS TRIGGERIDS : OidSet .
  vars RB RB1 RB2 : ReactionBody .
  vars CONST CONST' : BoolValue .
  var TSTATUS : TriggerStatus .
  vars PRE INVOKED : ReactionIdSet .

  op _timeBound_ : ClockedSystem TimeInf -> ClockedSystem [ctor] .



  crl [tick] :
    {< E : Environment | physicalActions : CONF1 >
     REACTORS-AND-CONNECTIONS
     < Q : EventQueue | queue : (EVENTS at tag(T1, N)) :: QUEUE >
     < RXNS : Invoked | >
     [physicalTime: PT]
     } timeBound TI2
   =>
    {< E : Environment | physicalActions : decreaseTimers(CONF1, T) >
     REACTORS-AND-CONNECTIONS
     < Q : EventQueue | >
     < RXNS : Invoked | reactions : none >
     [physicalTime: PT plus T]
     } timeBound (TI2 monus T)
  if T := minimum(T1 monus PT, smallestTimer(CONF1), TI2)   --- should be nondet time increase, bounded by this value. But for now, we do the easy thing and assume that for each physical action, we have this timer.
   /\ T gt zero .

  crl [tickWhileExecuting] :
  {
    executeStep(
      GRAPH,
      LT,
      < E : Environment | physicalActions : CONF1 >
      NETWORK
      [physicalTime: PT]
      [numberProcessors: NP2] ,
      CONST
    )
  } timeBound TI2
  =>
  {
    executeStep(
      executeReactions(GRAPH, T),
      LT,
      < E : Environment | physicalActions : decreaseTimers(CONF1, T) >
      NETWORK
      [physicalTime: PT plus T]
      [numberProcessors: NP2] ,
      CONST
    )
  } timeBound (TI2 monus T)
  if T := 1 /\ T le maxRemainingExecutionTime(GRAPH, NETWORK) /\ noIdling(GRAPH, NP2)
    /\ T le smallestTimer(CONF1) /\ T le TI2 .

  crl [extraTickRuleForPhysActs] :
    {< E : Environment | physicalActions : CONF1 >
     REACTORS-AND-CONNECTIONS
     < Q : EventQueue | queue : empty >
     < RXNS : Invoked | >
     [physicalTime: PT]
     } timeBound TI2
   =>
    {< E : Environment | physicalActions : decreaseTimers(CONF1, T) >
     REACTORS-AND-CONNECTIONS
     < Q : EventQueue | >
     < RXNS : Invoked | reactions : none >
    [physicalTime: PT plus T]
    } timeBound (TI2 monus T)
   if T := minimum(smallestTimer(CONF1), TI2)
   /\ T gt zero
   /\ CONF1 =/= none .      --- implied by typing of T

endom


*** Case 5: unbounded and time-bounded analysis.
*** The user must do TWO things:
***    a. for unbounded analysis start with state {...} timeBound INF
***    b. for time-bounded analysis set the value after 'timeBound' to the desired value.

omod TIMED-SIMULATION-DYNAMICS is
  including DYNAMICS-FUNCTIONS .

  vars REACTORS-AND-CONNECTIONS CONF1 PHYSICAL-ACTIONS : Configuration .
  vars T T1 T2 T3 PT LT : Time .
  vars TI2 TI TI1 : TimeInf .
  vars E Q RXNS : Oid .
  vars N N2 NP2 NP : Nat .
  var EVENTS : Events .
  var QUEUE : EQueue .
  var NETWORK : Configuration .
  var REACTORID : ReactorId .
  var GRAPH : Configuration .
  vars REACTIONS1 REACTIONS2 : ReactionList .
  vars OS TRIGGERIDS : OidSet .
  vars RB RB1 RB2 : ReactionBody .
  vars CONST CONST' : BoolValue .
  var TSTATUS : TriggerStatus .
  vars PRE INVOKED : ReactionIdSet .
   
  op _timeBound_ : ClockedSystem TimeInf -> ClockedSystem [ctor] .

  eq {C:Configuration} timeBound TI = {C:Configuration} in time 0 timeBound TI .


  crl [tick] :
    {< E : Environment | physicalActions : CONF1 >
     REACTORS-AND-CONNECTIONS
     < Q : EventQueue | queue : (EVENTS at tag(T1, N)) :: QUEUE >
     < RXNS : Invoked | >
     [physicalTime: PT]
     } in time T3 timeBound TI2
   =>
    {< E : Environment | physicalActions : decreaseTimers(CONF1, T) >
     REACTORS-AND-CONNECTIONS
     < Q : EventQueue | >
     < RXNS : Invoked | reactions : none >
     [physicalTime: PT plus T]
     } in time (T + T3) timeBound (TI2 monus T)
   if T := minimum(T1 monus PT, smallestTimer(CONF1), TI2)   --- should be nondet time increase, bounded by this value. But for now, we do the easy thing and assume that for each physical action, we have this timer.
   /\ T gt zero .


  crl [tickWhileExecuting] :
  {
    executeStep(
      GRAPH,
      LT,
      < E : Environment | physicalActions : CONF1 >
      NETWORK
      [physicalTime: PT]
      [numberProcessors: NP2] ,
      CONST
    )
  } in time T3 timeBound TI2
  =>
  {
    executeStep(
      executeReactions(GRAPH, T),
      LT,
      < E : Environment | physicalActions : decreaseTimers(CONF1, T) >
      NETWORK
      [physicalTime: PT plus T]
      [numberProcessors: NP2] ,
      CONST
    )
  } in time (T + T3) timeBound (TI2 monus T)
  if T := 1 /\ T le maxRemainingExecutionTime(GRAPH, NETWORK) /\ noIdling(GRAPH, NP2)
    /\ T le smallestTimer(CONF1) /\ T le TI2 .

  crl [extraTickRuleForPhysActs] :
    {< E : Environment | physicalActions : CONF1 >
     REACTORS-AND-CONNECTIONS
     < Q : EventQueue | queue : empty >
     < RXNS : Invoked | >
     [physicalTime: PT]
     } in time T3 timeBound TI2
   =>
    {< E : Environment | physicalActions : decreaseTimers(CONF1, T) >
     REACTORS-AND-CONNECTIONS
     < Q : EventQueue | >
     < RXNS : Invoked | reactions : none >
    [physicalTime: PT plus T]
    }
    in time (T + T3) timeBound (TI2 monus T)
   if T := minimum(smallestTimer(CONF1), TI2)
   /\ T gt zero
   /\ CONF1 =/= none .      --- implied by typing of T

endom

--- NOTICE: In general, our states are tuples
--- (newState, reactionsInvokedToReachNewState)
--- so we should be aware of the order.  If you want
--- something like "if X == 2" then reaction R should fire
--- cannot be checked by just looking at such a (newState, reactionsFired)
--- pair.  However, a property "if R fires then X == 2 [afterwards]" can be
--- checked by just inspecting such a (newState, reactionsFiredToReachNewState)
--- pair.    The latter properties are the ones appearing in the "Towards verifying ..."
--- paper, as well as in the benchmarks repository.
---    Note 2:  Since we handle all reactions at a given tag in one step,
---  we do not need much of the complexity of the LF formulas and stuff, which
---  use interleaving of all the reactions that take place at the same time.
--- The main property for ADAS example has the for us desired form.
--- Of course, we can also check the former, non-existing, properties, since
--- the pre-state is available in the previous state.
