omod DYNAMICS-WITHOUT-TICK-LOGICALTIME is
  including EXECUTE-STEP-LOGICALTIME .

  --- At the moment, the global state is
  --- < env : Environment | physicalActions : ... >
  --- REACTORS and CONNECTIONS in some state
  --- < q : EventQueue | queue : ... >

  vars REACTORS-AND-CONNECTIONS PHYSICAL-ACTIONS NEW-NETWORK CONF1 : Configuration .
  vars QUEUE NEW-QUEUE : EQueue .
  vars E Q PA RXNS O : Oid .
  var INVOKED : ReactionIdSet .
  var EVENTS : Events .
  var CONST : BoolValue .
  var TI : TimeInf .
  vars T T1 T2 PT : Time .
  var N NP : Nat .
  var REST : Configuration .
  var REACTORID : ReactorId .
  var VAR : VarId .
  var VAL : Value .
  var RS : ReactorState .
  var RID : ReactionId .
  var RIDS : ReactionIdSet .
  vars EQ1 EQ2 : EQueue .
  var EVENT : Event .
  var TAG : Tag .
  var ACTIONHISTORY : ActionHistory .
  
  *** We need some initialization, obviously.  DONE

  *** We have some freedom here; IF an event can happen
  *** at the same time when a physical action could happen, we always
  *** make the physical action happen first.
  ---  In reality physical actions and events probably
  ---  will never happen at the same time.


  crl [step] :
      {< E : Environment | physicalActions : CONF1 >
       REACTORS-AND-CONNECTIONS
       < Q : EventQueue | queue : (EVENTS at tag(T, N)) :: QUEUE, pastActions : ACTIONHISTORY >
       < RXNS : Invoked | >
       [physicalTime: PT] 
       [numberProcessors: NP]
       } 
  =>
      {
        C:Configuration
      } in time T2
      if PT ge T /\ smallestTimer(CONF1) gt zero 
      /\ {executeStep(EVENTS, T,
          < E : Environment | physicalActions : CONF1 >
          REACTORS-AND-CONNECTIONS
          < Q : EventQueue | queue : QUEUE, pastActions : add(EVENTS at tag(T, N), ACTIONHISTORY) >
          < RXNS : Invoked | reactions : none >
          [physicalTime: PT] 
          [numberProcessors: NP],
          trueVal
          )}
      =>
        {
            finished(C:Configuration)
        } in time T2 .

--- variant without time advance
  crl [step] :
      {< E : Environment | physicalActions : CONF1 >
       REACTORS-AND-CONNECTIONS
       < Q : EventQueue | queue : (EVENTS at tag(T, N)) :: QUEUE, pastActions : ACTIONHISTORY >
       < RXNS : Invoked | >
       [physicalTime: PT] 
       [numberProcessors: NP]
       }
  =>
      {
        C:Configuration
      }
      if PT ge T /\ smallestTimer(CONF1) gt zero 
      /\ {executeStep(EVENTS, T,
          < E : Environment | physicalActions : CONF1 >
          REACTORS-AND-CONNECTIONS
          < Q : EventQueue | queue : QUEUE, pastActions : add(EVENTS at tag(T, N), ACTIONHISTORY) >
          < RXNS : Invoked | reactions : none >
          [physicalTime: PT]
          [numberProcessors: NP],
          trueVal
          )}
      =>
        {
            finished(C:Configuration)
        } .


  *** Note: condition ensures that physical actions are generated
  ***       before events are processed.
endom

*** We now add the tick rule, which is slightly different for three cases:
---  1. Basic Real-Time Maude model and semantics of LF, with "standard"
---     tick rule, perfect for, e.g., simulation purposes.
---  2. A tick rule for unbounded model checking analysis; this uses
---     the same tick rule, except that we do not carry the global
---     clock in the state. We just remove the "in time T" part of
---     the tick rule.
---  3. Time-bounded analysis: we must modify the tick rule so that
---     time does not advance beyond the bound.

*** For each of these choices, select the appropriate of the below modules:

omod SIMULATION-DYNAMICS-LOGICALTIME is
  including DYNAMICS-WITHOUT-TICK-LOGICALTIME .
  including SIMULATION-DYNAMICS-COMMON .

endom


*** Case 3: time-bounded analysis.
*** The user must do TWO things:
***    a. start with state {...} in time 0
***    b. set the value of the constant 'timeBound' to the desired value.

omod TIME-BOUNDED-DYNAMICS-LOGICALTIME is
  including DYNAMICS-WITHOUT-TICK-LOGICALTIME .
  including TIME-BOUNDED-DYNAMICS-COMMON .


  vars REACTORS-AND-CONNECTIONS CONF1 PHYSICAL-ACTIONS : Configuration .
  vars T1 T T2 T3 T4 PT LT : Time .
  vars TI TI1 TI2 : TimeInf .
  vars E Q RXNS : Oid .
  vars N2 N NP2 NP : Nat .
  var EVENTS : Events .
  var QUEUE : EQueue .
  var NETWORK : Configuration .
  var REACTORID : ReactorId .
  var GRAPH : Configuration .
  vars REACTIONS1 REACTIONS2 : ReactionList .
  vars RB RB1 RB2 : ReactionBody .
  vars CONST CONST' : BoolValue .
  vars OS TRIGGERIDS : OidSet .
  var TSTATUS : TriggerStatus .
  vars PRE INVOKED : ReactionIdSet .
  var ACTIONHISTORY : ActionHistory .

  op timeBound : -> Time .   *** initialized by user


  crl [step] :
      {< E : Environment | physicalActions : CONF1 >
       REACTORS-AND-CONNECTIONS
       < Q : EventQueue | queue : (EVENTS at tag(T, N)) :: QUEUE, pastActions : ACTIONHISTORY >
       < RXNS : Invoked | >
       [physicalTime: PT] 
       [numberProcessors: NP]
       } in time T3
  =>
      {
        C:Configuration
      } in time T4
      if PT ge T /\ smallestTimer(CONF1) gt zero 
      /\ {executeStep(EVENTS, T,
          < E : Environment | physicalActions : CONF1 >
          REACTORS-AND-CONNECTIONS
          < Q : EventQueue | queue : QUEUE, pastActions : add(EVENTS at tag(T, N), ACTIONHISTORY) >
          < RXNS : Invoked | reactions : none >
          [physicalTime: PT] 
          [numberProcessors: NP],
          trueVal
          )} in time T3
      =>
        {
            finished(C:Configuration)
        } in time T4 .

endom
