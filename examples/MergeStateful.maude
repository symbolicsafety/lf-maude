omod TEST-MERGESTATEFUL is
    including MERGESTATEFUL .
    including DYNAMICS-WITHOUT-TICK-LOGICALTIME .

    ops env queue rxns : -> Oid [ctor] .

    op initSystem : -> GlobalSystem .
    eq minExtime = 15 .
    eq maxExtime = 15 .
    eq initSystem =
        { < env : Environment |
            physicalActions : 
                < (event . event.m-pa.a ): PhysAct | 
                                  leftOfPeriod : 5, 
                                  period : 5, 
                                  possibleValues : [1], 
                                  timeNonDet : false >
             > 
            addReactionIndices(init)
            < queue : EventQueue | queue : 
            addInitialTimers(init, empty), pastActions : empty >
            < rxns : Invoked | reactions : none >
            [physicalTime: 0]
            [numberProcessors: 1]} .
endom

