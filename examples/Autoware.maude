omod TEST-AUTOWARE is
    including AUTOWARE .
    including DYNAMICS-WITHOUT-TICK-LOGICALTIME .

    ops env queue rxns : -> Oid [ctor] .

    op initSystem : -> GlobalSystem .
    eq minExtime = 10 .
    eq maxExtime = 10 .
    eq initSystem =
        { < env : Environment |
            physicalActions : 
                < (iobjectdetection . iobjectdetection.m-pa.CUDA ): PhysAct | leftOfPeriod : 100, period : 100, possibleValues : [1]: [2], timeNonDet : true >
             > 
            addReactionIndices(init)
            < queue : EventQueue | queue : 
            addInitialTimers(init, empty), pastActions : empty >
            < rxns : Invoked | reactions : none >
            [physicalTime: 0]
            [numberProcessors: 1]} .
endom

